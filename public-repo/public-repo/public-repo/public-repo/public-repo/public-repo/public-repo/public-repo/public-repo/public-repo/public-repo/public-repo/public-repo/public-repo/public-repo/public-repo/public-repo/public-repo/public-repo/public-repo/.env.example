# Required — point these at YOUR GCP project's real resources. There are no
# defaults for these in app/config.py: a misconfigured deployment fails fast
# at startup instead of silently talking to Chameleon's own dev/prod.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
JANITOR_DLQ_TOPIC=janitor-dead-letter-queue-<instance>
PII_TOPIC_ID=projects/your-gcp-project-id/topics/pii-ingestion-stream-<instance>
LINEAGE_TOPIC_ID=projects/your-gcp-project-id/topics/pii-lineage-events-stream-<instance>
LANDING_ZONE_BUCKET=your-landing-zone-bucket-name
BIGQUERY_DATASET=your_bigquery_dataset
KMS_KEY_PATH=projects/your-gcp-project-id/locations/us-central1/keyRings/your-key-ring/cryptoKeys/your-key-vault-key
KMS_SIGNING_PROJECT_ID=your-gcp-project-id
KMS_SIGNING_KEY_RING=your-signing-key-ring
KMS_SIGNING_KEY_NAME=your-cert-signing-key

# Optional — sensible defaults in app/config.py if unset.
VAULT_BASE_URL=http://localhost:8080
# STAGING_DATASET / STAGING_DATASET_ID override BIGQUERY_DATASET if set;
# leave unset to just use BIGQUERY_DATASET.
# STAGING_DATASET=
# STAGING_DATASET_ID=
STAGING_TABLE=raw_users
KMS_SIGNING_KEY_VERSION=1
TENANT_MODE=MULTI

# Optional — warehouse discovery (off by default: empty datasets = no-op crawl).
# WAREHOUSE_DISCOVERY_PROJECT_ID=  # defaults to GOOGLE_CLOUD_PROJECT if unset
# WAREHOUSE_DISCOVERY_DATASETS=
# WAREHOUSE_DISCOVERY_SAMPLE_LIMIT=1000
# WAREHOUSE_DISCOVERY_EXCLUDED_TABLE_PATTERNS=

# Optional — Salesforce integration (mock mode by default).
# SALESFORCE_MODE=mock
# SALESFORCE_LOGIN_URL=https://test.salesforce.com
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_USERNAME=
# SALESFORCE_PASSWORD=
# SALESFORCE_SECURITY_TOKEN=
